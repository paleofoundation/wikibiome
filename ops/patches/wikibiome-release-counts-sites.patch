+  get concepts() { return getReleaseCorpus().stats.concepts; },
+  get interventions() { return getReleaseCorpus().stats.interventions; },
+  get stops() { return getReleaseCorpus().stats.stops; },
+  get analyses() { return getReleaseCorpus().stats.analyses; },
