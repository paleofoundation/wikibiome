+
+export const dynamic = "force-dynamic";
+export const metadata: Metadata = { title: "Edit public profile — WikiBiome", robots: { index: false, follow: false } };
+
+export default async function EditProfilePage() {
+  const account = await getResearcherSession();
+  return <><WikiHeader /><main className="project-page">
+    <header className="project-page-hero"><span>Researcher profile</span><h1>Edit your public profile</h1><p>Update your name, biography, affiliations, and self-declared expertise.</p></header>
