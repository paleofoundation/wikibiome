+    <section className="support-independence"><h2>Citations are never for sale.</h2><p>Payment cannot purchase inclusion, authorship verification, favorable treatment, or scientific recognition.</p><Link href="/research-standard">Read the research standard →</Link></section>
+  </main></>;
+}
