--- /dev/null
+++ b/app/_components/ResearcherProfileForm.tsx
@@ -0,0 +1,34 @@
+"use client";
+
+import { useState, type FormEvent } from "react";
+
+type Profile = { displayName: string; biography: string; affiliations: string[]; expertiseSelf: string[]; orcid: string };
+
+export function ResearcherProfileForm({ account }: { account: Profile }) {
+  const [saving, setSaving] = useState(false);
+  const [message, setMessage] = useState("");
+  async function save(event: FormEvent<HTMLFormElement>) {
+    event.preventDefault();
+    const form = new FormData(event.currentTarget);
+    setSaving(true);
+    setMessage("");
+    try {
+      const response = await fetch("/api/researcher/profile", {
+        method: "PATCH", headers: { "content-type": "application/json" },
+        body: JSON.stringify(Object.fromEntries(form)),
+      });
+      const result = await response.json() as { error?: string };
+      setMessage(response.ok ? "Public profile saved. Open your profile to see the changes." : result.error || "Your profile could not be saved.");
+    } catch { setMessage("Could not reach WikiBiome. Your edits are still here; try saving again."); }
+    finally { setSaving(false); }
+  }
+  return <form className="research-form" onSubmit={save}>
+    <label><span>Public name</span><input name="name" defaultValue={account.displayName} maxLength={180} required /></label>
+    <label><span>Biography</span><textarea name="biography" defaultValue={account.biography} maxLength={3000} rows={5} /></label>
+    <label><span>Self-declared affiliations · one per line</span><textarea name="affiliations" defaultValue={account.affiliations.join("\n")} rows={4} /></label>
+    <label><span>Self-declared expertise · one per line</span><textarea name="expertise" defaultValue={account.expertiseSelf.join("\n")} rows={4} /></label>
+    <footer><p>These fields are public. Your ORCID identity, verified work, and evidence-derived expertise are managed separately.</p><button disabled={saving}>{saving ? "Saving…" : "Save public profile"}</button></footer>
+    <p role="status">{message}</p>
+    <a href={`/researchers/${account.orcid}`}>View public profile →</a>
+  </form>;
+}
