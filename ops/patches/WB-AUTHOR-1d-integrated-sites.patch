diff --git a/app/api/researcher/profile/route.ts b/app/api/researcher/profile/route.ts
new file mode 100644
index 0000000..a29f173
--- /dev/null
+++ b/app/api/researcher/profile/route.ts
@@ -0,0 +1,14 @@
+import { assertSameOriginRequest, getResearcherSessionFromRequest, updateResearcherAccount } from "@/lib/research-network";
+
+export async function PATCH(request: Request) {
+  try { assertSameOriginRequest(request); }
+  catch { return Response.json({ error: "Cross-site requests are not accepted." }, { status: 403 }); }
+  const account = await getResearcherSessionFromRequest(request);
+  if (!account?.orcid) return Response.json({ error: "ORCID sign-in is required." }, { status: 401 });
+  try {
+    const payload = await request.json() as Record<string, unknown>;
+    if (!payload || typeof payload !== "object" || Array.isArray(payload) || typeof payload.name !== "string" || !payload.name.trim()) return Response.json({ error: "A public name is required." }, { status: 400 });
+    await updateResearcherAccount(account.accountId, { name: payload.name, biography: payload.biography, affiliations: payload.affiliations, expertise: payload.expertise });
+    return Response.json({ saved: true }, { headers: { "cache-control": "private, no-store" } });
+  } catch { return Response.json({ error: "Your profile could not be saved. Check the fields and try again." }, { status: 400 }); }
+}
