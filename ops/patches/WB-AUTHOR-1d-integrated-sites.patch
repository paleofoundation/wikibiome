diff --git a/scripts/verify-author-workflow.mjs b/scripts/verify-author-workflow.mjs
new file mode 100644
index 0000000..12aa964
--- /dev/null
+++ b/scripts/verify-author-workflow.mjs
@@ -0,0 +1,108 @@
+// Explicit local integration check. Never accepts a remote origin or database.
+import assert from "node:assert/strict";
+import { createHash, randomUUID } from "node:crypto";
+import { readFileSync, readdirSync, realpathSync } from "node:fs";
+import { resolve, sep } from "node:path";
+import { spawnSync } from "node:child_process";
+
+const origin = new URL(process.argv[2] || "http://localhost:4194");
+assert.ok(["localhost", "127.0.0.1"].includes(origin.hostname) && origin.protocol === "http:", "Only a local HTTP test server is allowed");
+const database = realpathSync(process.argv[3]);
+assert.ok(database.startsWith(realpathSync(".wrangler") + sep) && database.endsWith(".sqlite"), "Only this checkout's local Wrangler database is allowed");
+const sql = (query) => {
+  const result = spawnSync("/usr/bin/sqlite3", [database], { input: query, encoding: "utf8" });
+  assert.equal(result.status, 0, result.stderr);
+  return result.stdout.trim();
+};
+if (!sql("SELECT name FROM sqlite_master WHERE name='accounts';")) {
+  for (const name of readdirSync("drizzle").filter((name) => /^\d{4}_.+\.sql$/.test(name)).sort()) sql(readFileSync(resolve("drizzle", name), "utf8"));
+}
+const prefix = `wb-author-${randomUUID()}`;
+const accounts = ["new", "trusted", "unverified"].map((kind, index) => ({
+  id: `${prefix}-${kind}`, kind, token: randomUUID(), orcid: `0000-0000-0000-000${index}`,
+}));
+const sourceId = "ahmed-2025-metals-alzheimers-mechanistic-review";
+const passed = [];
+async function request(path, { account, body, method = "GET", crossSite = false } = {}) {
+  return fetch(new URL(path, origin), { method, headers: {
+    ...(account ? { cookie: `wikibiome_researcher_session=${account.token}` } : {}),
+    origin: crossSite ? "https://example.invalid" : origin.origin,
+    ...(body !== undefined ? { "content-type": "application/json" } : {}),
+  }, ...(body !== undefined ? { body: JSON.stringify(body) } : {}) });
+}
+try {
+  for (const account of accounts) {
+    const hash = createHash("sha256").update(account.token).digest("base64url");
+    sql(`INSERT INTO accounts(id,display_name,role) VALUES('${account.id}','Local author fixture','${account.kind === "trusted" ? "trusted_contributor" : "researcher"}');
+      INSERT INTO researcher_profiles(account_id,orcid,name) VALUES('${account.id}','${account.orcid}','Local author fixture');
+      INSERT INTO account_identities(id,account_id,provider,provider_subject) VALUES('${account.id}','${account.id}','orcid','${account.orcid}');
+      INSERT INTO researcher_emails(id,account_id,email,verified_at) VALUES('${account.id}','${account.id}','${account.id}@example.invalid',${account.kind === "unverified" ? "NULL" : "'2026-01-01T00:00:00Z'"});
+      INSERT INTO account_sessions(token_hash,account_id,expires_at) VALUES('${hash}','${account.id}','2099-01-01T00:00:00Z');`);
+  }
+  const profileBody = { name: "Local edited author", biography: "Local integration fixture. No scientific claims.", affiliations: "Fixture institute", expertise: "Methods", accountId: accounts[1].id, role: "site_admin", orcid: accounts[1].orcid };
+  let response = await request("/api/researcher/profile", { method: "PATCH", body: profileBody });
+  assert.equal(response.status, 401); passed.push("Anonymous profile mutation rejected");
+  response = await request("/api/researcher/profile", { account: accounts[0], method: "PATCH", body: profileBody, crossSite: true });
+  assert.equal(response.status, 403); passed.push("Cross-origin profile mutation rejected");
+  response = await request("/api/researcher/profile", { account: accounts[2], method: "PATCH", body: profileBody });
+  assert.equal(response.status, 200, await response.text());
+  response = await request("/api/account", { account: accounts[2] });
+  let data = await response.json();
+  assert.equal(data.account.displayName, profileBody.name);
+  assert.equal(data.account.biography, profileBody.biography);
+  assert.equal(data.account.role, "researcher");
+  assert.equal(data.account.orcid, accounts[2].orcid);
+  assert.equal(data.account.emailVerified, false);
+  assert.equal(sql(`SELECT name FROM researcher_profiles WHERE account_id='${accounts[1].id}';`), "Local author fixture");
+  response = await request(`/researchers/${accounts[2].orcid}`);
+  const profileHtml = await response.text();
+  assert.match(profileHtml, /Local edited author/);
+  assert.match(profileHtml, /Local integration fixture/);
+  assert.ok(!profileHtml.includes(`${accounts[2].id}@example.invalid`));
+  passed.push("ORCID session can edit public fields without private-email verification; fields persist publicly, ownership and role protected");
+  const topic = { targetType: "source", targetId: sourceId, title: "Local fixture question", category: "question", body: "Which methods are documented in this source record?", conflictDisclosure: "Local test fixture" };
+  response = await request("/api/discussions", { method: "POST", body: topic });
+  assert.equal(response.status, 401);
+  response = await request("/api/discussions", { account: accounts[2], method: "POST", body: topic });
+  assert.equal(response.status, 400);
+  passed.push("Anonymous and unverified-email discussion writes rejected");
+  response = await request("/api/discussions", { account: accounts[0], method: "POST", body: topic });
+  assert.equal(response.status, 201);
+  const pending = await response.json();
+  assert.equal(pending.status, "pending");
+  assert.equal(sql(`SELECT status FROM discussion_posts WHERE id='${pending.postId}';`), "pending");
+  response = await request(`/api/discussions?targetType=source&targetId=${sourceId}`);
+  data = await response.json();
+  assert.ok(!data.discussions.some((item) => item.thread.id === pending.threadId));
+  passed.push("New researcher source post persists pending and is absent from public discussion");
+  response = await request("/api/discussions", { account: accounts[1], method: "POST", body: topic });
+  assert.equal(response.status, 201);
+  const published = await response.json();
+  assert.equal(published.status, "published");
+  response = await request(`/api/discussions?targetType=source&targetId=${sourceId}`);
+  data = await response.json();
+  assert.ok(data.discussions.some((item) => item.thread.id === published.threadId && item.posts.some((post) => post.id === published.postId)));
+  response = await request(`/source/${sourceId}`);
+  assert.match(await response.text(), /Local fixture question/);
+  passed.push("Trusted ORCID session source post persists and renders on the public source record");
+  response = await request(`/api/discussions/${published.threadId}/posts`, { account: accounts[1], method: "POST", body: { body: "Local fixture reply for persistence verification." } });
+  assert.equal(response.status, 201);
+  const reply = await response.json();
+  assert.equal(sql(`SELECT count(*) FROM discussion_post_revisions WHERE post_id='${reply.postId}';`), "1");
+  passed.push("Source reply persists with immutable first revision");
+  console.log(JSON.stringify({ environment: "isolated local staging; fixture sessions, not external ORCID OAuth", origin: origin.origin, passed }, null, 2));
+} finally {
+  const ids = accounts.map((account) => `'${account.id}'`).join(",");
+  sql(`DELETE FROM discussion_post_revisions WHERE post_id IN (SELECT id FROM discussion_posts WHERE account_id IN (${ids}));
+    DELETE FROM discussion_posts WHERE account_id IN (${ids});
+    DELETE FROM discussion_threads WHERE created_by_account_id IN (${ids});
+    DELETE FROM researcher_notifications WHERE actor_account_id IN (${ids});
+    DELETE FROM researcher_follows WHERE account_id IN (${ids});
+    DELETE FROM rate_limit_events WHERE account_id IN (${ids});
+    DELETE FROM audit_events WHERE actor_account_id IN (${ids});
+    DELETE FROM researcher_emails WHERE account_id IN (${ids});
+    DELETE FROM account_sessions WHERE account_id IN (${ids});
+    DELETE FROM account_identities WHERE account_id IN (${ids});
+    DELETE FROM researcher_profiles WHERE account_id IN (${ids});
+    DELETE FROM accounts WHERE id IN (${ids});`);
+}
