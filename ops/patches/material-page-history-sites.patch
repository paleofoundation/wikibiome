@@ -4,4 +4,4 @@ import { WikiHeader } from "@/app/_components/WikiArticle";
 import { publicPageMetadata } from "@/lib/search-discovery";
 
 export const metadata: Metadata = publicPageMetadata({ title: "Research network governance — WikiBiome", description: "Moderation, notification, recognition, messaging, and researcher-event policies for WikiBiome researchers.", path: "/research-governance" });
-export default function ResearchGovernancePage() { return <><WikiHeader/><main className="project-page"><header className="project-page-hero"><span>Research network governance</span><h1>Participation is visible. Power stays accountable.</h1><p>These rules keep researcher collaboration useful without turning citation, visibility, recognition, or invitations into popularity contests.</p></header><article className="project-prose"><section><h2>Where papers are reviewed</h2><p>Appointed topic reviewers work in the <Link href="/researcher/review">Review work workspace</Link>. Administrators appoint reviewers; editors assign papers there. A researcher account alone does not grant review authority. Authors and submitters cannot approve their own work; a separate independent editor decides whether reviewed article changes may be published.</p><p>Submitters can follow processing, requested revisions, decisions and publication in <Link href="/researcher/submissions">My papers</Link>. Until an independent reviewer is assigned, the status explicitly says “Awaiting reviewer assignment.”</p></section><section><h2>Moderation</h2><p>The first three approved discussion posts—not merely submitted posts—are required before a researcher can publish directly. Moderators may premoderate, lock, hide, reject, or restore material; every decision is audited. Patient-specific advice, personal health information, impersonation, promotion, coercive citation behavior, and unsupported treatment claims are prohibited.</p></section><section><h2>Notifications</h2><p>In-app notifications cover replies, ORCID mentions, decisions, proposal activity, contact requests, and messages. Direct replies and moderation decisions may be emailed only when research-email consent is enabled. Ordinary followed activity is eligible for batching. Suppression always overrides preferences.</p></section><section><h2>Public attribution</h2><p>Accepted proposals and author context link to authenticated ORCID profiles. Pending, declined, withdrawn, or rejected work is visible only to its author and moderators. Accepted-but-unpublished proposals are labeled clearly until linked to an exact upstream Git revision.</p></section><section><h2>Messaging</h2><p>Contact is opt-in and mutual. Researchers can disable new requests, decline a request, block another account, or report a message. Participants see their conversation; moderators see reported material only as needed to review safety or conduct. Messaging is not end-to-end encrypted.</p></section><section><h2>Recognition and appeals</h2><p>Stars are quality milestones with public reasons, not a leaderboard. New awards at levels one through three require qualifying published scientific contributions. A paper counts once regardless of how many pages it improves; historical awards retain their recorded policy. Levels four and five require human review. Supporter status never affects recognition. Appeals go to <a href="mailto:researchers@wikibiome.com">researchers@wikibiome.com</a>.</p></section><section><h2>Conference and Roundtable selection</h2><p>The interest registry creates no event entitlement. Researchers with four or five stars, active interest, and separate early-invitation consent may enter a private shortlist for the event types they select. Human organizers assess subject fit, quality, conflicts, conduct, and interdisciplinary representation before any invitation.</p></section><section><h2>Editorial publication</h2><p>Claims, submissions, proposals, and discussions cannot edit the generated corpus directly. Accepted work becomes a change packet for the upstream repository and passes existing sync, audit, build, review, and publication gates.</p></section><section><h2>Related policies</h2><p><Link href="/privacy">Privacy</Link> · <Link href="/terms">Terms of Use</Link> · <Link href="/research-standard">WikiBiome-Ready Research</Link> · <Link href="/roundtable">Research event interest</Link></p></section></article></main></>; }
