diff --git a/docs/operations/public-page-history.md b/docs/operations/public-page-history.md
new file mode 100644
index 0000000..c10587f
--- /dev/null
+++ b/docs/operations/public-page-history.md
@@ -0,0 +1,29 @@
+# Public page history
+
+Apply this policy to every WikiBiome article and source page, its history view,
+change counter, and public activity API. Add an entry only for a material change
+published on that page. Describe the change to the page, not the work used to
+produce it. Content, evidence, conclusions, and published author context qualify.
+Reviews, approvals, status transitions, discussions/replies, checks, deployment
+receipts, and Git commits by themselves do not qualify. Keep discussion and
+private operational audit records in their existing separate systems.
+
+The shared policy is `lib/public-page-history-policy.mjs`. Revision generation
+compares the affected page before/after each commit. Internal metadata, comments,
+and whitespace-only changes do not qualify. Public fields are explicitly listed;
+review that list when introducing new rendered article fields. Subjects of batch
+commits are retained as source provenance but never used as public change titles.
+Accepted proposals need a complete recorded publication commit and published text.
+Nonempty accepted author context qualifies because it is rendered on the source
+page. The activity trail coalesces proposal and Git records for the same commit.
+
+Regenerate with `npm run revisions:sync` when the synchronized upstream snapshot
+is available. `node scripts/generate-revision-history.mjs --classify-existing`
+classifies the existing indexed revisions without refreshing article content or
+changing the synchronized source snapshot. Inaccessible commit diffs are omitted
+rather than labeled material without evidence; `omittedUnavailable` records that
+count. The build audit rejects histories from an older policy or unverified rows.
+
+Generated derivative pages retain source provenance but do not inherit their
+parent article’s unrelated changes as their own history. Track a derivative’s
+published output before adding its material-change timeline.
diff --git a/lib/public-page-history-policy.mjs b/lib/public-page-history-policy.mjs
new file mode 100644
index 0000000..8f2cab0
--- /dev/null
+++ b/lib/public-page-history-policy.mjs
@@ -0,0 +1,52 @@
+import yaml from "js-yaml";
+
+export const PAGE_HISTORY_POLICY_VERSION = 1;
+export const PAGE_HISTORY_DESCRIPTION = "This record shows only material changes published on this page, including changes to its content, evidence, conclusions, or author context. Internal processes and discussion activity are excluded. Pending, declined, and withdrawn proposals remain private.";
+
+// Only fields consumed as public article content qualify. Operational fields,
+// timestamps, review bookkeeping and source-count maintenance do not.
+const PUBLIC_FIELDS = ["title", "type", "subtype", "name", "description", "summary", "sources", "confidence", "evidence_level", "key_enzymes", "metal_dependencies", "associated_conditions"];
+function normalize(value) {
+  if (Array.isArray(value)) return value.map(normalize);
+  if (value && typeof value === "object") return Object.fromEntries(Object.keys(value).sort().map(key => [key, normalize(value[key])]));
+  return typeof value === "string" ? value.replace(/\s+/g, " ").trim() : value;
+}
+export function publicPageSnapshot(markdown) {
+  const match = String(markdown || "").match(/^---\r?\n([\s\S]*?)\r?\n---(?:\r?\n|$)/);
+  let metadata = {};
+  if (match) {
+    try { metadata = yaml.load(match[1], { json: true }) || {}; }
+    catch {
+      // Historical source files contain malformed YAML. Preserve their public
+      // field text for comparison; never confuse a parse failure with no content.
+      for (const key of PUBLIC_FIELDS) {
+        const field = match[1].match(new RegExp(`^${key}:([^\\n]*(?:\\n[ \t]+[^\\n]*)*)`, "m"));
+        if (field) metadata[key] = field[1].trim();
+      }
+    }
+  }
+  const body = String(markdown || "").slice(match?.[0].length || 0)
+    .replace(/<!--[\s\S]*?-->/g, "")
+    .replace(/^\s*[-*_]{3,}\s*$/gm, "")
+    .replace(/\[\[([^\]|]+)(?:\|([^\]]+))?\]\]/g, (_match, target, label) => label || target.replace(/-/g, " "))
+    .replace(/(\*\*|__)([^\n]+?)\1/g, "$2")
+    .replace(/\s+/g, " ").trim();
+  return { metadata: normalize(Object.fromEntries(PUBLIC_FIELDS.filter(key => metadata[key] !== undefined).map(key => [key, metadata[key]]))), body };
+}
+export function materialPageChange(before, after) {
+  const previous = publicPageSnapshot(before);
+  const current = publicPageSnapshot(after);
+  if (JSON.stringify(previous) === JSON.stringify(current)) return null;
+  if (!current.body && !Object.keys(current.metadata).length) return null;
+  return {
+    materialChange: true,
+    summary: !previous.body && !Object.keys(previous.metadata).length ? "Article content first published" : previous.body !== current.body ? "Updated article content" : "Updated published article information",
+  };
+}
+
+export function isPublishedProposalChange(proposal) {
+  return proposal.status === "accepted" && /^[a-f0-9]{40}$/i.test(proposal.publishedCommit || "") && Boolean(proposal.proposedContent?.trim());
+}
+export function isPublishedAuthorContext(review) {
+  return review.status === "accepted" && Boolean(review.context?.trim());
+}
