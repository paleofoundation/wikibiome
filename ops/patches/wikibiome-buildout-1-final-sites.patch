diff --git a/tests/release-counts.test.mjs b/tests/release-counts.test.mjs
new file mode 100644
index 0000000..501e5ac
--- /dev/null
+++ b/tests/release-counts.test.mjs
@@ -0,0 +1,23 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import {build} from 'esbuild';
+import {readFileSync} from 'node:fs';
+import {fileURLToPath} from 'node:url';
+const root=fileURLToPath(new URL('../',import.meta.url));
+async function release(poison=false){
+ const result=await build({absWorkingDir:root,stdin:{contents:`import {wikiStats,getReleaseCorpus,getDiseaseRecord,generateArticleEvidence} from './lib/wikibiome';import {realReferenceKeys} from './lib/article-quality.mjs';import {GET} from './app/sitemap.xml/route';export const stats={...wikiStats};export const paths=getReleaseCorpus().pages.map(p=>'/article/'+p.id);export const sitemap=GET().text();export const realSources=realReferenceKeys(getReleaseCorpus().pages.flatMap(p=>getDiseaseRecord(p.id)?.evidence.references??generateArticleEvidence(p).references)).length;`,resolveDir:root,loader:'ts'},bundle:true,platform:'node',format:'esm',packages:'external',write:false,logLevel:'silent',plugins:poison?[{name:'stale-upstream-inventory',setup(b){b.onLoad({filter:/content\.generated\.json$/},args=>{const corpus=JSON.parse(readFileSync(args.path,'utf8'));for(const key of Object.keys(corpus._stats))corpus._stats[key]=987654321;return {contents:JSON.stringify(corpus),loader:'json'};});}}]:[]});
+ return import('data:text/javascript;base64,'+Buffer.from(result.outputFiles[0].text).toString('base64'));
+}
+test('public counts match actual sitemap articles and real distinct cited source rows',async()=>{
+ const r=await release(),xml=await r.sitemap;
+ const articlePaths=[...xml.matchAll(/<loc>[^<]+(\/article\/[^<]+)<\/loc>/g)].map(m=>m[1]);
+ assert.deepEqual([...r.paths].sort(),articlePaths.sort());assert.equal(new Set(r.paths).size,r.paths.length);
+ assert.equal(r.stats.totalPages,r.paths.length);assert.equal(r.stats.sources,r.realSources);
+ assert.equal(r.stats.entities+r.stats.concepts+r.stats.signatures,r.stats.totalPages);
+ assert(r.stats.sources>0);assert.doesNotMatch(String(r.stats.totalPages),/^822$/);assert.notEqual(r.stats.sources,1940);
+ console.log('Derived current-release counts',JSON.stringify(r.stats));
+});
+test('stale or poisoned upstream inventory metadata cannot change public counters',async()=>{
+ const current=await release(),poisoned=await release(true);
+ assert.deepEqual(poisoned.stats,current.stats);assert.deepEqual(poisoned.paths,current.paths);
+});
