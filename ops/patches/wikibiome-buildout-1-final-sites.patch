+    const reportPath = join(folder, "report.json");
+    const baseline = spawnSync(process.execPath, ["scripts/lint-sitemap-quality.mjs", `--report=${reportPath}`], { cwd: new URL("../", import.meta.url), encoding: "utf8" });
