{
  "name": "site-creator-vinext-starter",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "prebuild": "node scripts/sync-wikibiome-content.mjs --audit-only && node scripts/generate-revision-history.mjs --audit-only && node scripts/audit-editorial-corpus.mjs --strict && npm run typecheck",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --test tests/*.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern work --ignore-pattern worker-configuration.d.ts",
    "typecheck": "tsc --noEmit --incremental false",
    "types:generate": "WRANGLER_LOG_PATH=.wrangler/wrangler.log wrangler types worker-configuration.d.ts --config dist/server/wrangler.json",
    "content:sync": "node scripts/sync-wikibiome-content.mjs",
    "content:check": "node scripts/check-wikibiome-upstream.mjs",
    "content:refresh": "node scripts/refresh-wikibiome-content.mjs",
    "content:audit": "node scripts/sync-wikibiome-content.mjs --audit-only",
    "editorial:audit": "node scripts/audit-editorial-corpus.mjs --strict",
    "editorial:audit:report": "node scripts/audit-editorial-corpus.mjs",
    "corpus:audit": "node scripts/audit-rendered-corpus.mjs",
    "audit:post-cutover": "node scripts/audit-wikibiome-post-cutover.mjs",
    "audit:post-cutover:test": "node --test tests/post-cutover-audit.test.mjs",
    "search:audit": "node scripts/audit-search-surface.mjs",
    "search:verify": "npm run build && node --test tests/rendered-html.test.mjs && npm run search:audit && npm run corpus:audit",
    "media:pilot": "node scripts/process-pilot-images.mjs",
    "revisions:sync": "node scripts/generate-revision-history.mjs",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "js-yaml": "4.3.2",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "web-vitals": "^6.2.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@openai/sites-vite-plugin": "0.1.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "react-server-dom-webpack": "19.2.6",
    "sharp": "^0.34.5",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.2",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
